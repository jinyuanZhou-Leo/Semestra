# input:  [Deployment environments, OAuth provider configuration, database URL, auth-session/runtime security settings, Resend auth-email configuration, and course-resource upload limits]
# output: [Template environment variables for local/prod backend setup]
# pos:    [Environment configuration template for backend runtime, JWT signing, CSRF-protected auth-cookie transport, and upload-size limits]
#
# ⚠️ When this file is updated:
#    1. Update these header comments
#    2. Update the INDEX.md of the folder this file belongs to
#
# Template for environment variables
# Copy this to .env for local development and fill in actual values

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Database Configuration
# Development: Use SQLite
# Production: Use Postgres (Cloud SQL/Supabase/Neon/etc.)
DATABASE_URL=sqlite:///./semestra.db

# Frontend URL
FRONTEND_URL=http://localhost:5173

# API host allowlist
# Production must set the public backend hostnames here, comma separated.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Trusted reverse-proxy IPs for X-Forwarded-For header processing.
# Set to the IP(s) of your load balancer or proxy, comma separated. Leave unset for direct deployments.
# Example: TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2
# TRUSTED_PROXY_IPS=

# JWT signing key
# Production must set a long random value here.
JWT_SECRET_KEY=replace-me-with-a-long-random-secret

# Auth cookie settings
AUTH_COOKIE_NAME=semestra_session
AUTH_CSRF_COOKIE_NAME=semestra_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
# Keep `lax` for same-site frontend/backend deployments. Use `none` only when you intentionally deploy cross-site and also enable HTTPS.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_DOMAIN=

# Rate-limit key HMAC secret (separate from JWT_SECRET_KEY so rotating one doesn't invalidate the other).
# Falls back to JWT_SECRET_KEY if unset.
# AUTH_RATE_LIMIT_KEY_SECRET=replace-me-with-a-long-random-secret

# Authentication rate limits
AUTH_RATE_LIMIT_IP_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_IP_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_IP_BLOCK_SECONDS=900
AUTH_RATE_LIMIT_ACCOUNT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_ACCOUNT_BLOCK_SECONDS=1800

# Auth email verification
RESEND_API_KEY=re_xxxxxxxxx
AUTH_EMAIL_FROM=Semestra <no-reply@auth.example.com>
# AUTH_EMAIL_REPLY_TO=support@example.com
AUTH_EMAIL_CODE_SECRET=replace-me-with-a-long-random-secret
AUTH_EMAIL_CODE_TTL_SECONDS=600
AUTH_EMAIL_CODE_RESEND_SECONDS=60
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5
AUTH_EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=600
AUTH_EMAIL_RATE_LIMIT_PER_HOUR=5
AUTH_EMAIL_IP_RATE_LIMIT_PER_HOUR=20

# Course resource upload limits
# Keep this at or below the account-wide quota unless you intentionally want larger single uploads rejected later by quota checks.
COURSE_RESOURCES_MAX_UPLOAD_BYTES=52428800

# Environment type: development or production
ENVIRONMENT=development
